# Переменные окружения ozon-collector (пример). Никаких секретов здесь нет.
# Кодировка: UTF-8. Пути относительные — от каталога запуска коллектора.

# --- Браузер -----------------------------------------------------------

# Автозапуск браузера при старте сбора (default: 1). 0 = только подключение
# к уже запущенному (manual: scripts/launch_chrome.ps1 / .sh).
OZON_AUTO_LAUNCH=1

# Окно браузера ВИДИМО поверх всех (default: 0). 1 = не сворачивать, удобно
# наблюдать за воркером. Аналог CLI: --window-mode visible.
OZON_KEEP_WINDOW=0

# Автономный Chrome (не зависит от системного Chrome и Google Update).
# Путь к chrome.exe ИЛИ к каталогу с ним (Chrome-for-Testing/Edge — любой
# Chromium). Никогда не обновляется сам. Установка:
#   python scripts/setup_bundled_chrome.py   (печатает готовую строку)
# Пустой = системный Chrome (лучший anti-automation отпечаток).
OZON_CHROME_PATH=

# Движок браузера (default: chrome). chrome = CDP + launch_chrome (без
# --enable-automation, navigator.webdriver=false — лучший отпечаток для Ozon FAB).
# firefox = альтернативный бэкенд: stock Firefox + geckodriver/Selenium (Marionette),
# persistent-профиль "{token}.firefox", свой профиль, НЕ CDP. Предусловие запуска:
# geckodriver в PATH + обычный firefox.exe (patched-сборку ms-playwright Ozon
# блокирует — в OZON_FIREFOX_PATH указывать только системный Firefox).
# Ограничения firefox: navigator.webdriver=true (geckodriver/Marionette — выше
# риск блока FAB, чем у chrome); окно не сворачивается (в свёрнутом Firefox не
# рендерятся lazy-блоки отзывов); первый вход в Ozon на профиле firefox —
# вручную один раз (куки живут в профиле).
# Опечатка значения → ValueError на старте.
OZON_BROWSER=chrome

# --- Параллелизм / профили ----------------------------------------------

# Максимум параллельных воркеров (default: 8). Реально ограничено
# OZON_PARALLEL_MAX и ресурсами; каждый воркер = свой Chrome/профиль/порт
# 9222+k. Аналог CLI: --parallel N.
OZON_PARALLEL_MAX=8

# Базовый каталог профилей воркеров (default: <LOCALAPPDATA>/opencode).
# На этой машине задано на уровне User: D:\Users\Neon\Projects\ozon-collector\.tmp\profiles
# Там 9 профилей (main + 8 воркеров) с куками и пройденной 18+ проверкой.
# НЕ удалять при уборке .tmp — это персистентное состояние, а не мусор.
OZON_PROFILE_BASE=

# Потолок дискового кеша Chromium на один браузер, МБ (default: 100).
# Замер 2026-10-07: без потолка профиль раздувался до 880 МБ, из них 92% —
# воспроизводимый Default/Cache + Code Cache; состояние сессии — 79 МБ на 9
# профилей. Уже раздутое чинится scripts/clean_profile_cache.py --apply.
OZON_DISK_CACHE_MB=

# --- Логи ----------------------------------------------------------------

# Лог коллектора (default: logs/ozon_collector.log). Аналог --log <path>.
OZON_COLLECTOR_LOG=logs/ozon_collector.log

# Лог попыток сбора (raw-решения по каждому PID).
OZON_ATTEMPT_LOG=logs/ozon_attempts.log

# Диагностика слайдера-пазла (0/1, каталог сохранения кадров).
OZON_PUZZLE_DIAG=0
OZON_PUZZLE_DIAG_DIR=logs/puzzle_diag

# --- Внутренние (инфраструктура воркеров; не менять без причины) ---------
# OZON_WORKER_ID       — метка воркера (port offset) для pipeline.
# OZON_WORKER_DOUBLES  — включает дублирование воркеров (dev).
# KD_NO_COOLDOWN       — отключает cooldown key_daemon (dev).
# KD_RANDOM_SEED       — детерминированный seed для рандома интервалов (dev).
# ВАЖНО: секреты (куки/токены) НЕ держать в .env — только в профилях браузера.